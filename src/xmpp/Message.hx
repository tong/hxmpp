package xmpp;

enum abstract MessageType(String) to String {
	/**
		The message is a standalone message that is sent outside the context of a one-to-one conversation or groupchat, and to which it is expected that the recipient will reply.
	**/
	var normal;

	/**
		The message is generated by an entity that experiences an error when processing a message received from another entity
	**/
	var error;

	/**
		The message is sent in the context of a one-to-one chat session.
	**/
	var chat;

	/**
		The message is sent in the context of a multi-user chat environment
	**/
	var groupchat;

	/**
		The message provides an alert, a notification, or other transient information to which no reply is expected
	**/
	var headline;

	@:from public static function fromString(s:String)
		return switch s {
			case 'normal': normal;
			case 'error': error;
			case 'chat': chat;
			case 'groupchat': groupchat;
			case 'headline': headline;
			case null, _: null;
		}
}

/**
	XMPP message stanza.

	The `<message/>` stanza kind can be seen as a *push* mechanism whereby one entity pushes information to another entity.

	Messages created with `new Message()` are of type `chat` unless another type is given.

	@see [RFC 6121 - Instant Messaging and Presence](https://xmpp.org/rfcs/rfc6121.html#message)
**/
@:forward(from, to, id, lang, error, type, body, subject, thread, threadParent, properties)
abstract Message(MessageStanza) to Stanza {
	public static inline var NAME = 'message';

	public inline function new(?to:String, ?body:String, ?subject:String, ?type:Null<MessageType>, ?thread:String, ?from:String)
		this = new MessageStanza(to, body, subject, type, thread, from);

	@:to public inline function toXML():XML
		return this.toXML();

	@:to public inline function toString():String
		return this.toString();

	@:from public static inline function fromString(str:String):Message
		return fromXML(XML.fromString(str));

	@:from public static inline function fromXML(xml:XML):Message
		return MessageStanza.parse(xml);
}

private class MessageStanza extends Stanza {
	/**
		Type of the message; a received message without or with an unknown type is of type `normal`.
	**/
	public var type:MessageType;

	/**
		Human-readable XML character data that specifies the textual contents.

		If the message contains bodies in multiple languages, this is the one without `xml:lang` (or the first);
		the others are kept in `properties`.
	**/
	public var body:String;

	/**
		Human-readable XML character data that specifies the topic.

		Multiple languages are handled like `body`.
	**/
	public var subject:String;

	/**
		String to uniquely identify a conversation thread or chat session.
	**/
	public var thread:String;

	/**
		Identifier of the parent thread if `thread` is a sub-thread.
	**/
	public var threadParent:String;

	public function new(?to:String, ?body:String, ?subject:String, ?type:MessageType = chat, ?thread:String, ?from:String) {
		super(to, from);
		this.body = body;
		this.subject = subject;
		this.type = type;
		this.thread = thread;
	}

	public function toXML():XML {
		var xml = Stanza.createXML(this, Message.NAME);
		if (type != null)
			xml.set("type", Std.string(type));
		if (subject != null)
			xml.append(XML.create("subject", subject));
		if (body != null)
			xml.append(XML.create("body", body));
		if (thread != null)
			xml.append(XML.create("thread", thread).set("parent", threadParent));
		for (e in properties)
			xml.append(e);
		if (error != null)
			xml.append(error.toXML());
		return xml;
	}

	public static function parse(xml:XML):Message {
		final m = Stanza.parseAttributes(new Message(), xml);
		final type:MessageType = xml.get('type');
		m.type = type ?? normal;
		// Of multiple bodies/subjects in different languages, use the default one
		function defaultText(name:String):Null<XML> {
			final elements = xml.elements.named(name);
			for (e in elements)
				if (!e.has('xml:lang'))
					return e;
			return elements[0];
		}
		final body = defaultText('body');
		final subject = defaultText('subject');
		for (e in xml.elements) {
			switch e.name {
				case 'body' if (e == body):
					m.body = e.text;
				case 'subject' if (e == subject):
					m.subject = e.text;
				case 'thread':
					m.thread = e.text;
					m.threadParent = e.get('parent');
				case 'error':
					m.error = e;
				case _:
					m.properties.push(e);
			}
		}
		return m;
	}
}
